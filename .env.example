# Local Docker Compose database. In production, replace host `db` with the
# hostname supplied by your PostgreSQL provider or hosting control panel.
POSTGRES_DB="autosuite"
POSTGRES_USER="autosuite"
POSTGRES_PASSWORD="change-this-database-password"
POSTGRES_PORT="55432"
DATABASE_URL="postgresql://autosuite:change-this-database-password@db:5432/autosuite?schema=public"

# Credentials for the dealer dashboard (HTTP Basic Auth)
DASHBOARD_USER="dealer"
DASHBOARD_PASSWORD="change-this-dashboard-password"

# Public HTTP listener used inside the container.
HOST="0.0.0.0"
PORT="3000"
