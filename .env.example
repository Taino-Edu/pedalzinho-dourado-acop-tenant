# Local Docker Compose database. In production, replace host `db` with the
# hostname supplied by your PostgreSQL provider or hosting control panel.
POSTGRES_DB="autosuite"
POSTGRES_USER="autosuite"
POSTGRES_PASSWORD="change-this-database-password"
POSTGRES_PORT="55432"
DATABASE_URL="postgresql://autosuite:change-this-database-password@db:5432/autosuite?schema=public"

# Credentials for the dealer dashboard (HTTP Basic Auth)
DASHBOARD_USER="dealer"
DASHBOARD_PASSWORD="change-this-dashboard-password"
DASHBOARD_SESSION_SECRET="change-this-session-secret"

# Painel geral da 3esysten. Use credenciais diferentes das concessionarias.
PLATFORM_ADMIN_USER="admin-geral"
PLATFORM_ADMIN_PASSWORD="change-this-platform-password"
PLATFORM_ADMIN_SESSION_SECRET="change-this-platform-session-secret"

# Public HTTP listener used inside the container.
HOST="0.0.0.0"
PORT="3000"

# Webmotors: hash fornecido à revenda após a contratação/homologação.
WEBMOTORS_AUTH_HASH=""

# Santander Financiamentos. Mantenha em "demonstracao" até a homologação.
SANTANDER_MODE="demonstracao"
SANTANDER_CLIENT_ID=""
SANTANDER_CLIENT_SECRET=""
SANTANDER_TOKEN_URL=""
SANTANDER_FINANCE_URL=""
SANTANDER_CERT_PATH=""
SANTANDER_KEY_PATH=""
SANTANDER_CERT_PASSPHRASE=""
