{
  "name": "pedalzinho-dourado-acop-tenant",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma white-label de vitrine e CRM para concessionárias",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node server.js",
    "db:seed": "node prisma/seed.js",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && node prisma/seed-production-once.js && node scripts/seed-brazilian-inventory.js",
    "db:reset": "prisma migrate reset --force",
    "market:warm": "node scripts/warm-market-cache.js",
    "inventory:brazil": "node scripts/seed-brazilian-inventory.js",
    "platform:seed": "node scripts/seed-platform-catalog.js",
    "build": "prisma generate",
    "start": "node server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
